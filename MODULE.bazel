module(
    name = "yikv_server",
    version = "0.0.1",
    compatibility_level = 1,
)

# ─── BCR 依赖（与 yikv/MODULE.bazel 对齐） ─────────────────────────────────────

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "googletest", version = "1.15.2")
bazel_dep(name = "google_benchmark", version = "1.9.4")
bazel_dep(name = "rules_proto", version = "5.3.0-21.7", repo_name = "rules_proto")
bazel_dep(name = "apple_support", version = "1.17.1")  # brpc 1.16.0 dep，Linux 上无害

# ── 与 brpc 1.16.0 MODULE.bazel 对齐的 BCR 依赖 ───────────────────────────────

bazel_dep(name = "protobuf", version = "27.3", repo_name = "com_google_protobuf")
# 实际图由传递依赖解析到 20240116.2；与 BCR 一致，减轻 GCC 14/15 + libc++ 头文件顺序问题。
bazel_dep(name = "abseil-cpp", version = "20240116.2", repo_name = "com_google_absl")
bazel_dep(name = "gflags", version = "2.2.2", repo_name = "com_github_gflags_gflags")
bazel_dep(name = "glog", version = "0.7.1", repo_name = "com_github_google_glog")
bazel_dep(name = "zlib", version = "1.3.1.bcr.5", repo_name = "com_github_madler_zlib")
bazel_dep(name = "libunwind", version = "1.8.1", repo_name = "com_github_libunwind_libunwind")

# ── 自定义 registry / 版本覆盖（同 yikv） ─────────────────────────────────────
bazel_dep(name = "leveldb", version = "1.23", repo_name = "com_github_google_leveldb")

bazel_dep(name = "babylon", version = "1.4.0")
single_version_override(
    module_name = "babylon",
    version = "1.4.0",
)
# thrift 不作为 Bzlmod 依赖：brpc tarball 内 MODULE 仅作参考；默认 @com_github_apache_brpc//:brpc
# 不定义 BRPC_WITH_THRIFT / with_thrift，不链 @org_apache_thrift。

# rules_cc transitive: bazel_features tarball from GitHub Releases（国内常需备用 url）
archive_override(
    module_name = "bazel_features",
    integrity = "sha256-LwV90CCYoQYJXqKRtDRCVzmKBZ6tssdMxHDeD5Zk3M0=",
    strip_prefix = "bazel_features-1.28.0",
    urls = [
        "https://github.com/bazel-contrib/bazel_features/releases/download/v1.28.0/bazel_features-v1.28.0.tar.gz",
        "https://ghproxy.net/https://github.com/bazel-contrib/bazel_features/releases/download/v1.28.0/bazel_features-v1.28.0.tar.gz",
    ],
    patches = ["//third_party:bazel_features_module_dot_bazel_version.patch"],
    patch_strip = 1,
)

# libpfm (transitive via google_benchmark): BCR 默认 netcologne.dl.sourceforge.net 常 DNS 失败；换镜像并保留 BCR 补丁。
archive_override(
    module_name = "libpfm",
    integrity = "sha256-XaX4hyveFLNjTJaI2YD2i9ootRAmhyPMEpc+7bq5/sw=",
    strip_prefix = "libpfm-4.11.0",
    urls = [
        "https://downloads.sourceforge.net/project/perfmon2/libpfm4/libpfm-4.11.0.tar.gz",
        "https://phoenixnap.dl.sourceforge.net/project/perfmon2/libpfm4/libpfm-4.11.0.tar.gz",
        "https://netcologne.dl.sourceforge.net/project/perfmon2/libpfm4/libpfm-4.11.0.tar.gz",
    ],
    patches = [
        "//third_party:libpfm_module_dot_bazel.patch",
        "//third_party:libpfm_add_build_file.patch",
    ],
    patch_strip = 1,
)

# 核心引擎源码在 libs/yikv/（与 sibling yikv 同步见 scripts/sync_yikv_lib.sh）

# ─── http_archive / 本地桩（同 yikv 思路） ────────────────────────────────────

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
local_tarball = use_repo_rule("//third_party:local_tarball_repo.bzl", "local_tarball")

new_local_repository(
    name = "openssl",
    path = "third_party/openssl_stub",
    build_file_content = """\
load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])
cc_library(name = "ssl",    linkopts = ["-lssl"])
cc_library(name = "crypto", linkopts = ["-lcrypto"])
""",
)

new_local_repository(
    name = "librdkafka",
    path = "third_party/librdkafka_stub",
    build_file_content = """\
load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])
cc_library(
    name = "rdkafka",
    hdrs = glob(["include/librdkafka/*.h"]),
    includes = ["include"],
    linkopts = ["-lrdkafka"],
)
""",
)

local_tarball(
    name = "nlohmann_json",
    src = "//third_party/tarball:nlohmann_json-v3.10.5.tar.gz",
    strip_prefix = "json-3.10.5",
    build_file_content = """\
load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])
cc_library(
    name = "json",
    hdrs = glob(["include/nlohmann/**/*.hpp"]),
    includes = ["include"],
)
""",
)

# brpc 1.16.0 (sources from committed tarball; see scripts/fetch_bazel_tarballs.sh)
local_tarball(
    name = "com_github_apache_brpc",
    src = "//third_party/tarball:brpc-1.16.0.tar.gz",
    strip_prefix = "brpc-1.16.0",
)
