module(
    name = "yikv",
    version = "0.0.1",
    compatibility_level = 1,
)

# ─── BCR 依赖 ─────────────────────────────────────────────────────────────────

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "googletest", version = "1.15.2")
bazel_dep(name = "google_benchmark", version = "1.9.4")
bazel_dep(name = "rules_proto", version = "5.3.0-21.7", repo_name = "rules_proto")
bazel_dep(name = "apple_support", version = "1.17.1")  # brpc 1.16.0 dep，Linux 上无害

bazel_dep(name = "yaml-cpp", version = "0.9.0", repo_name = "com_github_jbeder_yaml_cpp")

# ── 与 brpc 1.16.0 MODULE.bazel 对齐的 BCR 依赖 ───────────────────────────────
bazel_dep(name = "protobuf", version = "27.3", repo_name = "com_google_protobuf")
bazel_dep(name = "abseil-cpp", version = "20230802.0", repo_name = "com_google_absl")
bazel_dep(name = "gflags", version = "2.2.2", repo_name = "com_github_gflags_gflags")
bazel_dep(name = "glog", version = "0.7.1", repo_name = "com_github_google_glog")
bazel_dep(name = "zlib", version = "1.3.1.bcr.5", repo_name = "com_github_madler_zlib")
bazel_dep(name = "libunwind", version = "1.8.1", repo_name = "com_github_libunwind_libunwind")

# ── 自定义 registry 依赖（secretflow） ───────────────────────────────────────
bazel_dep(name = "leveldb", version = "1.23", repo_name = "com_github_google_leveldb")
single_version_override(
    module_name = "leveldb",
    registry = "https://ghproxy.net/https://raw.githubusercontent.com/secretflow/bazel-registry/main",
)

# ── 自定义 registry 依赖（babylon registry，用于 babylon + thrift） ───────────
bazel_dep(name = "babylon", version = "1.4.0")
single_version_override(
    module_name = "babylon",
    version = "1.4.0",
    registry = "https://ghproxy.net/https://raw.githubusercontent.com/baidu/babylon/main/registry",
)

bazel_dep(name = "thrift", version = "0.21.0", repo_name = "org_apache_thrift")
single_version_override(
    module_name = "thrift",
    version = "0.21.0",
    registry = "https://ghproxy.net/https://raw.githubusercontent.com/baidu/babylon/main/registry",
)

# ─── http_archive 依赖（非 BCR，需手动声明） ──────────────────────────────────

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

new_local_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:local.bzl",
    "new_local_repository",
)

# brpc 1.16.0 的 BUILD 无论是否使用 BoringSSL 均引用 @openssl//:ssl 和 @openssl//:crypto。
# 通过空目录桩 + build_file_content 注册这两个 target，实际链接系统 OpenSSL。
new_local_repository(
    name = "openssl",
    path = "third_party/openssl_stub",
    build_file_content = """\
load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])
cc_library(name = "ssl",    linkopts = ["-lssl"])
cc_library(name = "crypto", linkopts = ["-lcrypto"])
""",
)

# ── ZooKeeper C 客户端（系统安装，apt install libzookeeper-mt-dev）──────────────
new_local_repository(
    name = "zookeeper_c",
    path = "/usr",
    build_file_content = """\
load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])
cc_library(
    name = "zookeeper_mt",
    hdrs = glob(["include/zookeeper/*.h"]),
    includes = ["include"],
    linkopts = ["-lzookeeper_mt"],
)
""",
)

