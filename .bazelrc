# 国内编译：模块注册表
#
# - Bazel Central Registry（bcr）目前无「阿里云 mirrors.aliyun.com」样式的公开全量镜像站，
#   仍使用官方 bcr.bazel.build（全球 CDN，多数环境下比直连 GitHub 稳）。
# - babylon / secretflow 的自定义 registry 走 GitHub Raw；在国内常超时，下面两行与
#   yikv 仓库中的 bazel/registries/ghproxy.bazelrc 一致，通过 ghproxy 拉取元数据。
# - 若公司政策要求依赖全部在阿里云内：可在阿里云 OSS（或内网 Artifactory）自建 registry 镜像，
#   再将下面两条替换为自建 registry 根路径（与 yikv 文档中「自建镜像」思路相同）。
#
common --registry=https://bcr.bazel.build
common --registry=https://ghproxy.net/https://raw.githubusercontent.com/baidu/babylon/main/registry
common --registry=https://ghproxy.net/https://raw.githubusercontent.com/secretflow/bazel-registry/main

# Vendor / tarball defaults (online by default — see `bazel/vendor.bazelrc`; optional `--config=vendor`).
import %workspace%/bazel/vendor.bazelrc

# rules_foreign_cc / CMake: propagate libstdc++ when linking helper binaries (e.g. leveldbutil).
build --action_env=LDFLAGS=-lstdc++
build --host_action_env=LDFLAGS=-lstdc++

# Optional: pin GCC 14 (install gcc-14 g++-14, e.g. Ubuntu 24.04+). Matches deploy/docker/Dockerfile builder-base.
build:gcc14 --action_env=CC=gcc-14
build:gcc14 --action_env=CXX=g++-14
build:gcc14 --host_action_env=CC=gcc-14
build:gcc14 --host_action_env=CXX=g++-14

# 国内源码包下载加速：启用后会把 github.com/raw.githubusercontent.com/objects.githubusercontent.com
# 的下载 URL 重写到 deploy/docker/bazel-downloader-ghproxy.cfg 里的镜像前缀。
# 用法：bazel build --config=cn //:yikv_server
common:cn --experimental_downloader_config=deploy/docker/bazel-downloader-ghproxy.cfg
common:cn --experimental_repository_downloader_retries=3
common:cn --http_timeout_scaling=3.0
common:cn --jobs=2
common:cn --local_resources=memory=HOST_RAM*.6
