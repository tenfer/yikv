# Bzlmod official vendor mode. The committed vendor/ tree is generated by:
#   bazel vendor --vendor_dir=vendor
#
# Normal builds use vendor/ first, avoiding repeated network fetches.
common --vendor_dir=vendor

# Hard offline verification:
#   bazel build --config=vendor_offline //...
common:vendor_offline --vendor_dir=vendor
common:vendor_offline --repository_disable_download
