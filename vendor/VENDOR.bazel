# Not needed by the Linux C++ library build; these transitive development/toolchain
# repos are brittle in root containers or mainland networks when refreshing vendor/.
ignore(
    '@@libpfm~',
    '@@rules_python~~python~python_3_11_aarch64-apple-darwin',
    '@@rules_python~~python~python_3_11_aarch64-unknown-linux-gnu',
    '@@rules_python~~python~python_3_11_ppc64le-unknown-linux-gnu',
    '@@rules_python~~python~python_3_11_s390x-unknown-linux-gnu',
    '@@rules_python~~python~python_3_11_x86_64-apple-darwin',
    '@@rules_python~~python~python_3_11_x86_64-unknown-linux-gnu',
)
